<?php
/**
 * Copyright © 2026 Roman Pasichnyk
 * SPDX-License-Identifier: OSL-3.0 OR AFL-3.0
 *
 * The store locator: every store (pickup location) of the website with its
 * address, hours, phone and email, directions, and a map in a <details> that
 * loads OpenStreetMap only when opened (a lazy iframe in a closed <details>
 * isn't fetched). A GET search narrows the list; no script.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Zero\StorePickup\ViewModel\Stores $stores
 */
$stores = $block->getData('stores');
$cards = $stores->all();
$query = $stores->query();
?>
<div class="zero-store-locator flex flex-col gap-8">
    <form method="get" action="<?= $escaper->escapeUrl($block->getUrl('storelocator')) ?>" class="flex flex-wrap items-end gap-3" role="search">
        <label class="flex flex-col gap-1 grow max-w-md">
            <span class="text-sm font-semibold"><?= $escaper->escapeHtml(__('City, postcode or street')) ?></span>
            <input type="search" name="q" value="<?= $escaper->escapeHtmlAttr($query) ?>" class="input input-bordered w-full">
        </label>
        <button type="submit" class="btn btn-primary"><?= $escaper->escapeHtml(__('Find a store')) ?></button>
        <?php if ($query !== ''): ?>
            <a class="link text-sm" href="<?= $escaper->escapeUrl($block->getUrl('storelocator')) ?>"><?= $escaper->escapeHtml(__('All stores')) ?></a>
        <?php endif; ?>
    </form>

    <?php if (!$cards): ?>
        <p class="text-base-content/70" data-store-locator-empty>
            <?= $escaper->escapeHtml($query !== '' ? __('No store matches "%1".', $query) : __('No stores to show yet.')) ?>
        </p>
    <?php else: ?>
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-store-locator>
            <?php foreach ($cards as $card): ?>
                <li class="flex flex-col gap-3 border border-base-300 p-5">
                    <h2 class="text-lg font-semibold"><?= $escaper->escapeHtml($card['name']) ?></h2>
                    <address class="not-italic text-sm leading-relaxed">
                        <?php foreach ($card['lines'] as $line): ?>
                            <?= $escaper->escapeHtml($line) ?><br>
                        <?php endforeach; ?>
                    </address>
                    <?php if ($card['hours'] !== ''): ?>
                        <p class="text-sm text-base-content/70 whitespace-pre-line"><?= $escaper->escapeHtml($card['hours']) ?></p>
                    <?php endif; ?>
                    <?php if ($card['phone'] !== '' || $card['email'] !== ''): ?>
                        <p class="flex flex-col text-sm">
                            <?php if ($card['phone'] !== ''): ?>
                                <a class="link" href="tel:<?= $escaper->escapeHtmlAttr(preg_replace('/[^\d+]/', '', $card['phone'])) ?>"><?= $escaper->escapeHtml($card['phone']) ?></a>
                            <?php endif; ?>
                            <?php if ($card['email'] !== ''): ?>
                                <a class="link" href="mailto:<?= $escaper->escapeHtmlAttr($card['email']) ?>"><?= $escaper->escapeHtml($card['email']) ?></a>
                            <?php endif; ?>
                        </p>
                    <?php endif; ?>
                    <p class="flex flex-wrap gap-4 text-sm">
                        <a class="link" href="<?= $escaper->escapeUrl($card['directions']) ?>" target="_blank" rel="noopener"><?= $escaper->escapeHtml(__('Directions')) ?></a>
                        <a class="link" href="<?= $escaper->escapeUrl($card['map']) ?>" target="_blank" rel="noopener"><?= $escaper->escapeHtml(__('Open in OpenStreetMap')) ?></a>
                    </p>
                    <?php if ($stores->showsMaps() && $card['embed'] !== ''): ?>
                        <details class="store-locator-map">
                            <summary class="cursor-pointer text-sm font-semibold"><?= $escaper->escapeHtml(__('Map')) ?></summary>
                            <iframe src="<?= $escaper->escapeUrl($card['embed']) ?>" loading="lazy"
                                    title="<?= $escaper->escapeHtmlAttr(__('Map: %1', $card['name'])) ?>"
                                    class="mt-3 w-full aspect-[4/3] border border-base-300"
                                    referrerpolicy="no-referrer"></iframe>
                        </details>
                    <?php endif; ?>
                </li>
            <?php endforeach; ?>
        </ul>
    <?php endif; ?>
</div>
