<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="zero.store.locator"
                   template="Zero_StorePickup::locator.phtml">
                <arguments>
                    <argument name="stores" xsi:type="object">Zero\StorePickup\ViewModel\Stores</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
